{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "AuthManager.Api": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "Data Source=auth.db" },
  "Redis": { "ConnectionString": "localhost:6379" },
  "Jwt": {
    "Issuer": "auth-manager",
    "Audience": "miivida",
    "Key": "",
    "ExpiresMinutes": 60
  },
  "Seed": { "Enabled": false },
  "Routing": {
    "LegacyBaseUrl": "https://legacy.example.com",
    "ModernBaseUrl": "https://app.example.com",
    "DefaultDestination": "Legacy",
    "Pages": [
      { "Path": "/", "Destination": "Legacy" }
    ]
  }
}
