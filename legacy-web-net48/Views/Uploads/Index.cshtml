@using LegacyWeb.Services
@{
    ViewBag.Title = "Uploads";
    var session = ViewBag.Session as SessionResult;
}

<h2>Uploads (legacy storage)</h2>
<p>Files posted here are saved under this app's own <code>App_Data\Uploads</code> folder. The modern app never sees them.</p>

@if (session != null)
{
    <p>Company: <strong>@session.CompanyName</strong></p>
}

@using (Html.BeginForm("Index", "Uploads", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <input type="file" name="file" />
    <button type="submit">Upload</button>
}

<h3>Files in this app's storage</h3>
<ul>
    @foreach (var name in (System.Collections.Generic.List<string>)ViewBag.Files)
    {
        <li>@name</li>
    }
</ul>
