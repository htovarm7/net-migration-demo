@model LegacyWeb.Models.ContactForm
@{
    ViewBag.Title = "Contact";
}

<h2>Contact</h2>

@using (Html.BeginForm("Index", "Contact", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <label>First name @Html.TextBoxFor(m => m.FirstName)</label>
    <label>Last name @Html.TextBoxFor(m => m.LastName)</label>
    <label>Email @Html.TextBoxFor(m => m.Email)</label>
    <label>File <input type="file" name="file" /></label>
    <button type="submit">Send</button>
}
