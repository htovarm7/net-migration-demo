@using LegacyWeb.Services
@{
    ViewBag.Title = "Orders";
    var session = ViewBag.Session as SessionResult;
}

<h2>Orders</h2>
<p>This page is still <strong>legacy</strong>: it is served by this .NET Framework 4.8 app.</p>

@if (session != null)
{
    <p>User: <strong>@session.FirstName @session.LastName</strong> (@session.Role)</p>
    <p>Company: <strong>@session.CompanyName</strong> (@session.CompanyId) &mdash; read from Redis through Auth Manager's <code>/session</code>.</p>
}

<table border="1" cellpadding="6" cellspacing="0">
    <tr><th>Order #</th><th>Status</th><th>Total</th></tr>
    @foreach (var order in (System.Collections.Generic.List<Order>)ViewBag.Orders)
    {
        <tr>
            <td>@order.Number</td>
            <td>@order.Status</td>
            <td>$@order.Total.ToString("N2")</td>
        </tr>
    }
</table>
