@using ModernWeb.Services
@{
    ViewData["Title"] = "Shared Forms";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var submissions = (List<FormSubmissionRecord>)ViewBag.Submissions;
}

<h2>Shared Forms</h2>

<form method="post" enctype="multipart/form-data">
    <input type="text" name="firstName" placeholder="First name" />
    <input type="text" name="lastName" placeholder="Last name" />
    <input type="text" name="email" placeholder="Email" />
    <input type="file" name="file" />
    <button type="submit">Submit</button>
</form>

<h3>History</h3>
<table border="1" cellpadding="6" cellspacing="0">
    <tr><th>When (UTC)</th><th>Name</th><th>Email</th><th>By</th><th>From</th><th>File</th></tr>
    @foreach (var s in submissions)
    {
        <tr>
            <td>@s.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
            <td>@s.FirstName @s.LastName</td>
            <td>@s.Email</td>
            <td>@s.SubmittedBy</td>
            <td>@s.SourceApp</td>
            <td>@(s.FileName ?? "-")</td>
        </tr>
    }
</table>
