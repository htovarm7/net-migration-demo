@using ModernWeb.Services
@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var company = ViewBag.Company as SessionContext;
    var sales = (MockSales.MonthlySummary)ViewBag.Sales;
}

<h2>Home</h2>

@if (company != null)
{
    <p>User: <strong>@company.FirstName @company.LastName</strong> (@company.Role)</p>
    <p>Company: <strong>@company.CompanyName</strong> (@company.CompanyId)</p>
}

<h3>This month</h3>
<p>Sales: <strong>$@sales.Total.ToString("N2")</strong> &middot; Orders: <strong>@sales.Orders</strong></p>
