@using ModernWeb.Services
@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var company = ViewBag.Company as SessionContext;
    var sales = (MockSales.MonthlySummary)ViewBag.Sales;
}

<h2>Home</h2>
<p>This page was <strong>migrated</strong> and is served by the new .NET 10 app.</p>
<p>Signed in as <strong>@User.Identity?.Name</strong>.</p>

@if (company != null)
{
    <p>Company: <strong>@company.CompanyName</strong> (@company.CompanyId) &mdash; read from Redis through Auth Manager's <code>/session</code>.</p>
}

<h3>This month</h3>
<p>Sales: <strong>$@sales.Total.ToString("N2")</strong> &middot; Orders: <strong>@sales.Orders</strong></p>
